# Copiază acest fișier în .env și completează valorile.

# Adresa backend-ului FastAPI (mitmed-api) — implicit rulează pe 8000 via Docker.
API_BASE_URL="http://localhost:8000"

# Origini permise să interogheze /api/session cross-origin (vezi acel route
# handler) — site-ul de prezentare (mitmed.ro, export static) îl folosește ca
# să știe dacă vizitatorul e deja autentificat, înainte de a-l trimite la
# programare. Listă separată prin virgulă.
PUBLIC_SITE_ORIGINS="https://mitmed.ro,https://www.mitmed.ro"
