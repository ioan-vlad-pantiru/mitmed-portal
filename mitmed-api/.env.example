# Copiază acest fișier în .env și completează valorile.

# "development" în local; "production" pe VPS — la production, API-ul refuză
# să pornească dacă SEED_ADMIN_PASSWORD mai e cel implicit din cod.
ENVIRONMENT="development"

DATABASE_URL="postgresql+psycopg://mitmed:mitmed_dev_password@localhost:5433/mitmed_portal"
SESSION_COOKIE_NAME="mitmed_session"
COOKIE_SECURE=false

# Originile de unde se fac cereri către API: mitmed-portal (Next.js, cu
# credențiale/cookie) ȘI site-ul de prezentare static (widget-ul public de
# programare, fără cookie) — actualizează cu domeniul real când e live.
CORS_ORIGINS='["http://localhost:3000", "https://mitmed.ro", "https://www.mitmed.ro"]'

# Google Calendar (sincronizare programări) — de completat când Sebastian
# ne dă acces la contul folosit acum pentru Google Calendar Appointment Schedule.
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_CALENDAR_ID=""

# SMS/WhatsApp remindere (Twilio) — no-op (doar logare) până se completează.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
REMINDER_DAY_BEFORE_HOURS=24
REMINDER_HOUR_BEFORE_HOURS=1

# Link Google Reviews — pt. nudge-ul de recenzie din portalul clientului.
GOOGLE_REVIEW_URL=""

SEED_ADMIN_EMAIL="sebastian@mitmed.ro"
SEED_ADMIN_PASSWORD="SchimbaMaLaPrimaAutentificare1!"

# Plată online (PayU Romania) — panoul de comerciant PayU > Setări > API.
# Fără acestea completate, "Plătește acum" din portalul clientului
# întoarce eroare (plata rămâne neîncasată/manuală, nu blochează nimic).
# Sandbox: https://secure.snd.payu.com · Producție: https://secure.payu.com
PAYU_BASE_URL="https://secure.snd.payu.com"
PAYU_POS_ID=""
PAYU_CLIENT_SECRET=""
# "A doua cheie" (MD5) — separată de client_secret, doar pentru verificarea
# semnăturii notificărilor primite pe /webhooks/payu.
PAYU_SECOND_KEY=""
# Trebuie accesibil din internet, nu doar din rețeaua Docker — altfel PayU
# nu poate trimite confirmarea de plată. În dev local, tunelează cu ngrok.
PUBLIC_API_BASE_URL="http://localhost:8000"
PORTAL_BASE_URL="http://localhost:3000"
